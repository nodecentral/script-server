{
  "_version": "1.1.0",
  "name": "Disk Usage",
  "group": "Admin",
  "description": "Confirms conf/scripts/data/logs bind mounts are connected, then shows a tree + df usage for a picked path.",
  "script_path": "disk_usage.sh",
  "working_directory": "/app/scripts",
  "parameters": [
    {
      "name": "mount",
      "param": "--mount",
      "type": "list",
      "description": "Path to inspect",
      "values": {
        "script": "/app/scripts/shared/list_mounts.sh",
        "shell": true
      },
      "default": "/app"
    },
    {
      "name": "depth",
      "param": "--depth",
      "type": "int",
      "description": "Tree depth",
      "default": "2",
      "min": 1,
      "max": 5
    }
  ]
}
